#!/bin/bash

# == HELPERS ================================================================= #

function source_if_exists()
{
    if [ -f "$1" ]; then
        source "$1"
    fi
}

# == ENVIRONMENT ============================================================= #

if [ -n "$SSH_CLIENT" ]; then
    export DISPLAY=10.0.2.2:0.0
fi

export PATH="$HOME/.local/bin:$PATH"

export EDITOR="nvim"
export HISTSIZE=50000
export HISTFILESIZE=50000

# == COMPLETION ============================================================== #

source ~/.git-completion.bash

# == PROMPT ================================================================== #

source ~/.git-prompt.sh

function virtualenv_info() {
    if [[ -n "$VIRTUAL_ENV" ]]; then
        venv="${VIRTUAL_ENV##*/}"
    else
        venv=''
    fi
    [[ -n "$venv" ]] && echo "(venv:$venv) "
}

export VIRTUAL_ENV_DISABLE_PROMPT=1

export PS1='\n$(virtualenv_info)\[\e[32m\][\u@\h] \[\e[33m\]\w \[\e[0m\]$(__git_ps1 "(%s)")\[\e[0m\]\n$ '

# == ALIASES ================================================================= #

alias nv='nvim'

alias cd2='cd ../..'
alias cd3='cd ../../..'
alias cd3='cd ../../..'
alias cd4='cd ../../../..'
alias cd5='cd ../../../../..'

alias ll='ls -l --color=auto'
alias ls='ls --color=auto'

# == TMUX ==================================================================== #

function format-tmux-window()
{
    IFS=':' read -r INDEX NAME FLAGS <<< "$1"

    PRE='['
    POST=']'

    if [[ $FLAGS =~ 'Z' ]]; then
        PRE="${PRE}[ "
        POST=" ]${POST}"
    else
        PRE="${PRE}  "
        POST="  ${POST}"
    fi

    echo "${PRE}${INDEX}:${NAME}${POST}"
}

if [[ -n "$(command -v tmux)" \
   && -n "$PS1" \
   && -z "$TMUX" \
   && -t 1 \
   && ! "$TERM" =~ 'screen' \
   && ! "$TERM" =~ 'tmux' \
   && ! "$TERM_PROGRAM" =~ 'vscode' ]]
then
    exec tmux new-session -A -s main
fi

# == DIRENV ================================================================== #

if [[ -n "$(command -v direnv)" ]]; then
    eval "$(direnv hook bash)"
fi

# ============================================================================ #
